# Docker build ignore patterns - AI 智慧私教 (1-12年级) v1.7.5
# Dependency directories
node_modules
client/node_modules

# Build outputs (pre-built client/dist is included for zero-build fast deploys)
# client/dist

# Environment and sensitive configuration
.env
.env*.local
.env.production
.env.development

# Python caches and compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Local database files, generated secrets, and logs
data/mistakes.db*
data/api_token
data/db_key
data/textbooks/
data/backups/
logs/
*.log

# Version control and editor config
.git
.gitignore
.dockerignore
.vscode/
.idea/

# Scratch/temp files
scratch/
temp/
tmp/
