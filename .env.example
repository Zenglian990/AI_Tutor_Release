# ==========================================
# AI Tutor 环境配置模板
# 复制此文件为 .env 并填入您的实际配置
# ==========================================

# HTTP 代理（访问 Google API 如需科学上网时配置，如 clash/v2ray 等）
# PROXY_URL=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897

# Gemini API Keys (支持多个 Key 自动故障轮换，至少配置一个)
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY_2=your_second_key_here
# GEMINI_API_KEY_3=your_third_key_here

# API 访问令牌（用于前端调用后端API的鉴权与HMAC签名）
# 首次启动会自动生成并持久化；生产环境请设置为强随机字符串
API_TOKEN=change-me-to-a-random-string

# 允许的前端来源（逗号分隔），生产环境请改为实际域名
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# 数据保留天数（超过此天数的历史会话将按策略清理）
DATA_RETENTION_DAYS=365

# AI 模型配置
# EMBED_MODEL=gemini-embedding-2
# CHAT_MODEL=gemini-flash-lite-latest

# DeepSeek 备用 API（Gemini 故障或配额耗尽时自动灾备降级）
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_API_URL=https://api.deepseek.com/v1
# 真实模型 ID: deepseek-chat 或 deepseek-reasoner
# DEEPSEEK_CHAT_MODEL=deepseek-chat

# 服务器端口
PORT=3001

# 运行模式: development | production
NODE_ENV=production

# 数据库加密主密钥（64位16进制字符，未配置时会自动持久化至 data/db_key 和 .env）
# DB_ENCRYPTION_KEY=

# ==========================================
# 鉴权与安全
# ==========================================
# 严格要求 API 凭证 (默认: true)
# REQUIRE_AUTH=true

# 本地开发绕过开关 (仅 development 下生效，生产必须 false)
LOCAL_DEV_BYPASS=false
