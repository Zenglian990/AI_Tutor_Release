# ==========================================
# AI Tutor 环境配置模板
# 复制此文件为 .env 并填入您的实际配置
# ==========================================

# HTTP 代理（访问 Google API 如需科学上网时配置，如 clash/v2ray 等）
# PROXY_URL=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897

# Gemini API Keys (支持多个 Key 自动故障轮换；未配置时进入纯客户端 Key 模式)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY_2=your_second_key_here
# GEMINI_API_KEY_3=your_third_key_here

# 主管理员 API 访问令牌（生产环境可选，用于运维接口鉴权；建议使用 32+ 字节随机字符串，切勿使用固定示例值）
# API_TOKEN=

# 首次初始化管理员 PIN 所需部署口令（未设置 PIN 时激活 /api/admin/pin 必需）
# ADMIN_SETUP_SECRET=

# 家长管理员会话与远程学情视图专用签名密钥（建议使用 32+ 字节随机字符串）
# PARENT_SESSION_SECRET=
# PARENT_VIEW_SECRET=

# 数据库字段加密主密钥（必须为 64 位十六进制字符串 / 32 字节）
# DB_ENCRYPTION_KEY=

# 允许的前端来源（逗号分隔），生产环境请改为实际域名
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# 数据保留天数（超过此天数的历史会话将按策略清理）
DATA_RETENTION_DAYS=365

# AI 模型配置
# EMBED_MODEL=gemini-embedding-001
# CHAT_MODEL=gemini-2.5-flash

# DeepSeek 备用 API（Gemini 故障或配额耗尽时自动灾备降级）
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_API_URL=https://api.deepseek.com/v1
# DEEPSEEK_CHAT_MODEL=deepseek-chat

# Edge-TTS 令牌（可选覆盖）
# EDGE_TTS_TRUSTED_TOKEN=

# 服务器端口
PORT=3001

# 运行模式: development | production
NODE_ENV=production

# ==========================================
# 鉴权与安全
# ==========================================
# 严格要求 API 凭证 (默认: true)
# REQUIRE_AUTH=true

# 本地开发绕过开关 (已废弃静态放行，生产必须 false)
LOCAL_DEV_BYPASS=false

# ==========================================
# Jev 决策引擎 (TypeSafe System One)
# ==========================================
# TYPESAFE_API_KEY=sk-your-typesafe-key
JEV_ENABLED=false
JEV_CONFIDENCE_THRESHOLD=0.85
